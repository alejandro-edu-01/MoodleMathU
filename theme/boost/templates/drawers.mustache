    <!-- =================== SCRIPTS PORTADA =================== -->
    <script>
    (function() {
        var phrases = [
            "Demuestra lo que eres capaz de resolver cuando nadie te dice cómo hacerlo.",
            "No es sobre memorizar fórmulas. Es sobre ver lo que otros no ven.",
            "Cada problema es una oportunidad. Los mejores clasificados saben cómo aprovecharla."
        ];
        var el = document.getElementById('fp-typewriter');
        if (!el) return;
        var phraseIdx = 0, charIdx = 0, deleting = false;

        function type() {
            var phrase = phrases[phraseIdx];
            if (!deleting) {
                el.innerHTML = phrase.slice(0, charIdx + 1) + '<span class="fp-cursor">|</span>';
                charIdx++;
                if (charIdx === phrase.length) {
                    deleting = true;
                    setTimeout(type, 2600);
                    return;
                }
            } else {
                el.innerHTML = phrase.slice(0, charIdx - 1) + '<span class="fp-cursor">|</span>';
                charIdx--;
                if (charIdx === 0) {
                    deleting = false;
                    phraseIdx = (phraseIdx + 1) % phrases.length;
                }
            }
            setTimeout(type, deleting ? 25 : 44);
        }

        // Espera a que el DOM esté listo antes de iniciar
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', type);
        } else {
            type();
        }
    })();
    </script>

